{
	"$4d": {
		"version": "1",
		"kind": "form"
	},
	"windowSizingX": "variable",
	"windowSizingY": "variable",
	"windowMinWidth": 800,
	"windowMinHeight": 600,
	"windowMaxWidth": 32767,
	"windowMaxHeight": 32767,
	"rightMargin": 20,
	"bottomMargin": 20,
	"events": [
		"onLoad",
		"onValidate",
		"onDataChange",
		"onCloseBox"
	],
	"windowTitle": "CEF Parameters Editor",
	"pages": [
		{
			"objects": {}
		},
		{
			"objects": {
				"TitleText": {
					"type": "text",
					"text": "CEF Parameters Editor",
					"top": 20,
					"left": 20,
					"width": 760,
					"height": 30,
					"fontSize": 18,
					"fontWeight": "bold"
				},
				"InfoText": {
					"type": "text",
					"text": "Edit Chromium Embedded Framework parameters. Changes will be saved to user preferences.",
					"top": 55,
					"left": 20,
					"width": 760,
					"height": 40,
					"fontSize": 11
				},
				"PlatformSelector": {
					"type": "dropdown",
					"top": 100,
					"left": 20,
					"width": 200,
					"height": 25,
					"dataSource": "Form:C1466.platformChoice",
					"dataSourceTypeHint": "object",
					"events": [
						"onDataChange"
					],
					"method": "ObjectMethods/PlatformSelector.4dm"
				},
				"SwitchesListBox": {
					"type": "listbox",
					"top": 135,
					"left": 20,
					"width": 760,
					"height": 350,
					"sizingX": "grow",
					"sizingY": "grow",
					"dataSource": "Form:C1466.switchesCollection",
					"selectionMode": "single",
					"scrollbarHorizontal": "automatic",
					"method": "ObjectMethods/SwitchesListBox.4dm",
					"events": [
						"onClick",
						"onDoubleClick",
						"onDataChange"
					],
					"listboxType": "collection",
					"currentItemSource": "Form:C1466.currentItem",
					"currentItemPositionSource": "Form:C1466.currentItemPos",
					"columns": [
						{
							"header": {
								"text": "Switch Name",
								"name": "HeaderName"
							},
							"name": "ColumnName",
							"footer": {
								"name": "FooterName"
							},
							"width": 300,
							"enterable": false,
							"dataSource": "This:C1470.key"
						},
						{
							"header": {
								"text": "Value",
								"name": "HeaderValue"
							},
							"name": "ColumnValue",
							"footer": {
								"name": "FooterValue"
							},
							"width": 440,
							"enterable": true,
							"events": [
								"onDataChange"
							],
							"dataSource": "This:C1470.value"
						}
					]
				},
				"AddButton": {
					"type": "button",
					"text": "Add Switch",
					"top": 495,
					"left": 20,
					"width": 120,
					"height": 25,
					"sizingY": "move",
					"events": [
						"onClick"
					],
					"method": "ObjectMethods/AddButton.4dm"
				},
				"RemoveButton": {
					"type": "button",
					"text": "Remove Switch",
					"top": 495,
					"left": 150,
					"width": 120,
					"height": 25,
					"sizingY": "move",
					"events": [
						"onClick"
					],
					"method": "ObjectMethods/RemoveButton.4dm"
				},
				"ReloadButton": {
					"type": "button",
					"text": "Reload",
					"top": 495,
					"left": 280,
					"width": 100,
					"height": 25,
					"sizingY": "move",
					"events": [
						"onClick"
					],
					"method": "ObjectMethods/ReloadButton.4dm"
				},
				"SaveButton": {
					"type": "button",
					"text": "Save",
					"top": 495,
					"left": 580,
					"width": 100,
					"height": 25,
					"sizingX": "move",
					"sizingY": "move",
					"events": [
						"onClick"
					],
					"method": "ObjectMethods/SaveButton.4dm",
					"style": "bevel"
				},
				"CancelButton": {
					"type": "button",
					"text": "Cancel",
					"top": 495,
					"left": 690,
					"width": 90,
					"height": 25,
					"sizingX": "move",
					"sizingY": "move",
					"events": [
						"onClick"
					],
					"method": "ObjectMethods/CancelButton.4dm"
				},
				"Button": {
					"type": "button",
					"text": "Button",
					"top": 20,
					"left": 733,
					"width": 47,
					"height": 39,
					"events": [
						"onClick"
					],
					"style": "help",
					"method": "ObjectMethods/Button.4dm"
				}
			}
		}
	],
	"method": "method.4dm",
	"editor": {
		"activeView": "View 1",
		"defaultView": "View 1",
		"views": {
			"View 1": {}
		}
	},
	"geometryStamp": 4
}